# ---------------------------------------------------------------
# Unity generated / machine-local folders
# (paths are anchored so a Unity project can live at the repo root
#  or in a subfolder later)
# ---------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/Consulo files
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Burst / Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Ss]erver[Dd]ata/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Blender working files
*.blend1
*.blend2

# Scratch
/scratch/

# Offscreen review renders. These are throwaway verification shots written by the
# editor tooling in Assets/_Project/Scripts/Editor (art-pass comparisons, collision
# probes, material match sheets). They regenerate on demand and run to hundreds of
# megabytes of PNG, so they stay out of LFS.
/ArtPass_Review/
/Cliff*_*/
/CliffKit_Proof/
/Compound_*/
/GenShed_*/
# ...except the Phase 1 sign-off package, which is a locked spec artefact rather
# than a throwaway render dump.
!/GenShed_Interior_P1_LOCKED/
/Rock_Proto/
/RockProto_Review/
/TerraceEast_Review/
/TripoShed_Inspection/

# Unity crash dumps and the editor's auto-recovery scene copies
mono_crash.*.json
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/Blender/renders*/
